# Postgres credentials used by Docker Compose (the `db` service and backend).
POSTGRES_USER=postgres
# REQUIRED: Compose refuses to start without this. Set a strong, unique value.
# Do NOT deploy with the placeholder below — CHANGE_ME is not a valid password.
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=yivi_business_wallet

# OpenID4VP disclosure runs against a hosted EUDI verifier; the default is the
# Yivi staging verifier. Override to point at your own deployment:
# EUDI_VERIFIER_URL=https://verifierapi.openid4vc.staging.yivi.app

# Comma-separated emails granted platform-admin
# PLATFORM_ADMIN_EMAILS=you@example.com

# Domain for QERDS digital addresses. Seeded and newly provisioned orgs get an
# address of <local-part>@<domain> (e.g. yivi@qerds.localhost). Defaults to
# qerds.localhost for local dev; set a real host on staging/production.
# QERDS_DEFAULT_ADDRESS_DOMAIN=qerds.staging.yivi.app

# PostGuard (encrypted file transfer). BOTH are REQUIRED — Compose refuses to
# start without them (the sidecar fails closed, the backend needs the key to
# store API keys at rest).
#
# Shared secret between the backend and the PostGuard sidecar. Generate with:
#   openssl rand -hex 32
POSTGUARD_SHARED_SECRET=CHANGE_ME
# Deployment master key: a hex-encoded 32-byte value that WRAPS each org's own
# (owner-configured) PostGuard encryption key at rest. The per-org key in turn
# encrypts that org's API key. REQUIRED — generate a unique value with:
#   openssl rand -hex 32
# Do NOT deploy with the placeholder below (it is not valid hex, so the backend
# refuses to start). Rotating this makes all previously stored per-org keys
# (and thus API keys) undecryptable.
POSTGUARD_KEY_ENCRYPTION_KEY=CHANGE_ME
# Encrypts per-org SMTP passwords at rest (AES-256, hex 32 bytes). REQUIRED to save
# e-mail settings (per-org SMTP for credential-offer + invitation mails). Generate a
# unique value with `openssl rand -hex 32`. Rotating it makes stored SMTP passwords
# undecryptable. Leave unset only if no org will configure e-mail.
EMAIL_ENCRYPTION_KEY=CHANGE_ME
# Encrypts per-org Slack incoming-webhook URLs at rest (AES-256, hex 32 bytes).
# REQUIRED to save Slack notification settings. Generate a unique value with
# `openssl rand -hex 32`. Rotating it makes stored webhook URLs undecryptable, so
# every org has to paste theirs again. Leave unset only if no org will use Slack.
SLACK_ENCRYPTION_KEY=CHANGE_ME
# Encrypts per-org Microsoft Teams webhook URLs at rest (AES-256, hex 32 bytes).
# REQUIRED to save Microsoft Teams notification settings. Generate a unique value
# with `openssl rand -hex 32`. Rotating it makes stored webhook URLs undecryptable,
# so every org has to paste theirs again. Leave unset only if no org will use Teams.
TEAMS_ENCRYPTION_KEY=CHANGE_ME
# Optional: language outbound transactional mail falls back to when the recipient's
# own preference is unknown. One of the locales the mail catalogue ships (`en`, `nl`);
# anything else fails the deploy at startup. Defaults to `en`.
# MAIL_DEFAULT_LOCALE=en
# Encrypts the per-org directory client secret at rest (AES-256, hex 32 bytes).
# REQUIRED to configure user & department provisioning from Microsoft Entra ID.
# Generate a unique value with `openssl rand -hex 32`. Rotating it makes stored
# client secrets undecryptable, so every provisioned org has to re-enter one.
# Leave unset if no org provisions from a directory.
PROVISIONING_ENCRYPTION_KEY=CHANGE_ME
# Encrypts the per-org CSC signing-provider client secret at rest (AES-256, hex
# 32 bytes). Generate with `openssl rand -hex 32`. Leave unset if no org connects
# to a CSC signing provider (a remote QTSP).
CSC_ENCRYPTION_KEY=CHANGE_ME
# Optional: which PostGuard for Business environment this deployment uses. The
# first two aim the sidecar's encrypt-and-upload at a key service and a storage;
# the third is the base of the <website>/download?uuid=... link the backend mails
# recipients itself when an org chooses "own SMTP server" for PostGuard
# notifications. All three name the same environment and must be switched
# together — the backend refuses to start on a mix, so a staging upload can never
# hand recipients a production link. Defaults to production.
# POSTGUARD_PKG_URL=https://pkg.postguard.eu
# POSTGUARD_CRYPTIFY_URL=https://storage.postguard.eu
# POSTGUARD_WEBSITE_URL=https://postguard.eu
# For staging, uncomment all three:
# POSTGUARD_PKG_URL=https://pkg.staging.postguard.eu
# POSTGUARD_CRYPTIFY_URL=https://storage.staging.postguard.eu
# POSTGUARD_WEBSITE_URL=https://staging.postguard.eu

# Deployment key that seals each org's WSCA activation secret at rest (AES-256-GCM,
# hex-encoded 32 bytes; source from a KMS/secret manager). REQUIRED once WSCA-backed
# holder binding is enabled (the ATTESTATION_HOLDER_WSCA_URL toggle below).
# Generate with: openssl rand -hex 32. See .ai/features/wsca-holder-binding.md.
# ATTESTATION_HOLDER_WSCA_KEK=CHANGE_ME
#
# WSCA-backed holder binding (holder keys live in the wallet-provider HSM under
# SECDSA sole control instead of software keys). Opt-in: set the wallet-provider
# URL to enable it (requires ATTESTATION_HOLDER=irmago and the KEK above).
#
# For LOCAL Docker testing, do NOT set these here — layer compose.wsca.yaml
# instead (it builds the backend with -tags wsca against a wallet-provider clone
# and defaults the URL to Yivi staging). You only need ATTESTATION_HOLDER_WSCA_KEK
# set. See .ai/features/wsca-holder-binding.md.
# ATTESTATION_HOLDER_WSCA_URL=https://wallet-provider.staging.yivi.app
# Parent dir for per-org walletmobile keystores (a persistent volume in prod).
# ATTESTATION_HOLDER_WSCA_KEYSTORE_DIR=/var/lib/ybw/wsca
# Trust the wallet-provider's dev/self-signed TLS cert (local/staging only).
# ATTESTATION_HOLDER_WSCA_INSECURE=false
