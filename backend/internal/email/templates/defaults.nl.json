{
  "shell": {
    "footer": "Verstuurd door {{orgName}} met de Yivi Business Wallet.",
    "linkFallback": "Of open deze link:"
  },
  "samples": {
    "credentialName": "Medewerkerspas",
    "claimUrl": "https://wallet.example.org/claim/voorbeeld",
    "txCode": "123456",
    "acceptUrl": "https://wallet.example.org/invite/voorbeeld",
    "message": "Hierbij het bestand dat we bespraken.",
    "downloadUrl": "https://postguard.example/download?uuid=voorbeeld"
  },
  "templates": {
    "credential_offer": {
      "subject": "{{orgName}} heeft je een credential uitgegeven: {{credentialName}}",
      "blocks": [
        { "type": "logo" },
        { "type": "heading", "text": "{{orgName}} heeft je een credential uitgegeven" },
        { "type": "paragraph", "text": "{{credentialName}} staat klaar om aan je wallet toe te voegen." },
        { "type": "button", "label": "Voeg het toe aan je wallet", "url": "{{claimUrl}}" },
        { "type": "paragraph", "text": "Je wallet vraagt om deze code: {{txCode}}" },
        { "type": "footer" }
      ]
    },
    "invitation": {
      "subject": "Je bent uitgenodigd voor {{orgName}}",
      "blocks": [
        { "type": "logo" },
        { "type": "heading", "text": "Je bent uitgenodigd voor {{orgName}}" },
        { "type": "paragraph", "text": "{{orgName}} nodigt je uit om lid te worden op de Business Wallet." },
        { "type": "button", "label": "Uitnodiging accepteren", "url": "{{acceptUrl}}" },
        { "type": "footer" }
      ]
    },
    "postguard_file": {
      "subject": "{{orgName}} heeft je een versleuteld bestand gestuurd",
      "blocks": [
        { "type": "logo" },
        { "type": "heading", "text": "{{orgName}} heeft je een versleuteld bestand gestuurd met PostGuard" },
        { "type": "paragraph", "text": "{{message}}" },
        { "type": "button", "label": "Open het bestand", "url": "{{downloadUrl}}" },
        { "type": "paragraph", "text": "Je opent het bestand door te bewijzen dat dit e-mailadres van jou is." },
        { "type": "footer" }
      ]
    },
    "smtp_test": {
      "subject": "Test-e-mail van je Business Wallet",
      "blocks": [
        { "type": "logo" },
        { "type": "heading", "text": "Je SMTP-instellingen werken" },
        { "type": "paragraph", "text": "Dit is een testbericht verstuurd vanuit {{orgName}}. Het gebruikt dezelfde opmaak en huisstijl als de e-mail die je ontvangers krijgen." },
        { "type": "footer" }
      ]
    }
  }
}
