  "templates": {
    "credential_offer": {
      "subject": "{{orgName}} has issued you a credential: {{credentialName}}",
      "blocks": [
        {
          "type": "logo"
        },
        {
          "type": "heading",
          "text": "{{orgName}} has issued you a credential"
        },
        {
          "type": "paragraph",
          "text": "{{credentialName}} is ready to be added to your wallet."
        },
        {
          "type": "button",
          "label": "Add it to your wallet",
          "url": "{{claimUrl}}"
        },
        {
          "type": "paragraph",
          "text": "Your wallet will ask for this code: {{txCode}}"
        },
        {
          "type": "footer"
        }
      ]
    },
    "invitation": {
      "subject": "You have been invited to join {{orgName}}",
      "blocks": [
        {
          "type": "logo"
        },
        {
          "type": "heading",
          "text": "You have been invited to join {{orgName}}"
        },
        {
          "type": "paragraph",
          "text": "{{orgName}} invited you to become a member on the Business Wallet."
        },
        {
          "type": "button",
          "label": "Accept the invitation",
          "url": "{{acceptUrl}}"
        },
        {
          "type": "footer"
        }
      ]
    },
    "postguard_file": {
      "subject": "{{orgName}} has sent you an encrypted file",
      "blocks": [
        {
          "type": "logo"
        },
        {
          "type": "heading",
          "text": "{{orgName}} has sent you an encrypted file with PostGuard"
        },
        {
          "type": "paragraph",
          "text": "{{message}}"
        },
        {
          "type": "button",
          "label": "Open the file",
          "url": "{{downloadUrl}}"
        },
        {
          "type": "paragraph",
          "text": "You open the file by proving ownership of this e-mail address."
        },
        {
          "type": "footer"
        }
      ]
    },
    "event_notification": {
      "subject": "{{eventName}} at {{orgName}}",
      "blocks": [
        {
          "type": "logo"
        },
        {
          "type": "heading",
          "text": "{{eventName}} at {{orgName}}"
        },
        {
          "type": "paragraph",
          "text": "Recorded on {{eventTime}}."
        },
        {
          "type": "paragraph",
          "text": "{{eventDetails}}"
        },
        {
          "type": "button",
          "label": "Open the audit log",
          "url": "{{auditUrl}}"
        },
        {
          "type": "footer"
        }
      ]
    },
    "signed_document": {
      "subject": "{{orgName}} has sent you a signed document",
      "blocks": [
        {
          "type": "logo"
        },
        {
          "type": "heading",
          "text": "{{orgName}} has sent you a signed document"
        },
        {
          "type": "paragraph",
          "text": "{{message}}"
        },
        {
          "type": "paragraph",
          "text": "The signed document is attached to this e-mail as a PDF."
        },
        {
          "type": "footer"
        }
      ]
    },
    "signature_requested": {
      "subject": "{{orgName}} asks you to sign a document",
      "blocks": [
        {
          "type": "logo"
        },
        {
          "type": "heading",
          "text": "A document is waiting for your signature"
        },
        {
          "type": "paragraph",
          "text": "{{orgName}} has asked you to sign {{documentName}}."
        },
        {
          "type": "button",
          "label": "Review and sign",
          "url": "{{signingUrl}}"
        },
        {
          "type": "footer"
        }
      ]
    },
    "smtp_test": {
      "subject": "Test e-mail from your Business Wallet",
      "blocks": [
        {
          "type": "logo"
        },
        {
          "type": "heading",
          "text": "Your SMTP settings work"
        },
        {
          "type": "paragraph",
          "text": "This is a test message sent from {{orgName}}. It uses the same layout and branding as the mail your recipients get."
        },
        {
          "type": "footer"
        }
      ]
    },
    "export_ready": {
      "subject": "Your {{orgName}} data export is ready",
      "blocks": [
        {
          "type": "logo"
        },
        {
          "type": "heading",
          "text": "Your data is ready to download"
        },
        {
          "type": "paragraph",
          "text": "Service for {{orgName}} has ended. Everything the wallet held for you — your organisation details, your attestations, your registered delivery messages and their evidence, and your activity log — is packaged in one file you can take to another provider."
        },
        {
          "type": "paragraph",
          "text": "The link works once and stops working after {{exportExpiry}}."
        },
        {
          "type": "button",
          "label": "Download your data",
          "url": "{{exportUrl}}"
        },
        {
          "type": "footer"
        }
      ]
    }
  }
}
