{
  "shell": {
    "footer": "Sent by {{orgName}} with the Yivi Business Wallet.",
    "linkFallback": "Or open this link:"
  },
  "samples": {
    "credentialName": "Employee badge",
    "claimUrl": "https://wallet.example.org/claim/sample",
    "txCode": "123456",
    "acceptUrl": "https://wallet.example.org/invite/sample",
    "message": "Here is the file we discussed.",
    "downloadUrl": "https://postguard.example/download?uuid=sample",
    "eventName": "Invited member",
    "eventDetails": "email: sam@example.org\nrole: member",
    "eventTime": "2026-01-14 09:32 UTC",
    "auditUrl": "https://wallet.example.org/acme/audit-log",
    "documentName": "Contract.pdf",
    "signingUrl": "https://wallet.example.org/acme/signing",
    "exportUrl": "https://wallet.example.org/api/v1/export/download/sample",
    "exportExpiry": "24 hours"
  },
  "events": {
    "membership.invited": "Invited member",
    "membership.invite_resent": "Resent invitation",
