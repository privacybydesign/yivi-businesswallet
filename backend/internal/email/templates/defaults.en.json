    "membership.declined": "Declined invitation",
    "membership.revoked": "Revoked membership",
    "membership.role_changed": "Changed role",
    "membership.expired": "Invitation expired",
    "wallet.bootstrapped": "Bootstrapped wallet",
    "wallet.suspended": "Suspended wallet",
    "wallet.revoked": "Revoked wallet",
    "wallet.representation_claimed": "Claimed representation",
    "wallet.representation_revoked": "Revoked representation",
    "qerds.message_sent": "Sent secure message",
    "qerds.message_received": "Received secure message",
    "qerds.address_provisioned": "Provisioned digital address",
    "qerds.address_default_changed": "Changed default address",
    "qerds.contact_added": "Added contact",
    "qerds.contact_deleted": "Deleted contact",
    "postguard.file_sent": "Sent encrypted file",
    "postguard.key_set": "Set PostGuard API key",
    "postguard.key_removed": "Removed PostGuard API key",
    "postguard.encryption_key_set": "Set PostGuard encryption key",
    "postguard.encryption_key_removed": "Removed PostGuard encryption key",
